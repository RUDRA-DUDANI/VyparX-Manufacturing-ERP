# Django. Set DJANGO_ENV=production only behind HTTPS.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production the defaults enable HTTPS redirect, one-year HSTS, and secure cookies.
# If TLS terminates at a reverse proxy, configure it to overwrite X-Forwarded-Proto
# and set DJANGO_TRUST_X_FORWARDED_PROTO=1. Only include trusted public origins.
DJANGO_TRUST_X_FORWARDED_PROTO=0
# Optional overrides: DJANGO_SECURE_SSL_REDIRECT, DJANGO_SECURE_HSTS_SECONDS,
# DJANGO_SESSION_COOKIE_SECURE, DJANGO_CSRF_COOKIE_SECURE.
CSRF_TRUSTED_ORIGINS=
# Firebase Web app (same Firebase project as the Admin service account)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Choose one Firebase Admin credential source. Never commit credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional browser origin allow-list
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional integrations
PASSWORD_RESET_CONTINUE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=VyaparX ERP
APP_PUBLIC_URL=
SUPPORT_EMAIL=
