rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // VyaparX business data is accessed through the authenticated Django API
    // using Firebase Admin SDK. Browser clients must not read/write records
    // directly; the Admin SDK bypasses these client rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
